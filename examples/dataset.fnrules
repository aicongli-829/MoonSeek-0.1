# Normalize a mixed dataset staging directory before ingestion.
scan recursive on
scan hidden off
scan extensions "jpg,jpeg,png,webp,json,csv,txt"
scan exclude ".filenest"

classify custom
category keyword "train" "train"
category keyword "validation" "validation"
category keyword "test" "test"
category extension "json,csv,txt" "metadata"
category extension "jpg,jpeg,png,webp" "unassigned"

conflict number
sort path
rename spaces
rename extension_lower

# Preview a controlled source export before importing it into a repository.
# Do not run this rule against an active working tree without reviewing the plan.
scan recursive on
scan hidden off
scan extensions "mbt,md,json,yml,yaml"
scan exclude ".git"
scan exclude ".filenest"

classify custom
category keyword "_test.mbt" "tests"
category extension "mbt" "src"
category extension "md" "docs"
category extension "json,yml,yaml" "config"

conflict skip
sort path
rename spaces

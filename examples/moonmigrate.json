{
  "formatVersion": 1,
  "project": "sample-desktop-app",
  "migrations": [
    {
      "id": "layout-v1",
      "fromVersion": 0,
      "toVersion": 1,
      "description": "Create the versioned data layout and relocate legacy settings.",
      "steps": [
        {
          "id": "create-data-directory",
          "op": "mkdir",
          "path": "data/v1"
        },
        {
          "id": "relocate-settings",
          "op": "move",
          "from": "settings.json",
          "to": "config/settings.json",
          "optional": true
        },
        {
          "id": "write-layout-marker",
          "op": "write",
          "path": "data/layout.version",
          "content": "1\n"
        },
        {
          "id": "retire-legacy-index",
          "op": "quarantine",
          "from": "cache/index.old",
          "optional": true
        }
      ]
    },
    {
      "id": "layout-v2",
      "fromVersion": 1,
      "toVersion": 2,
      "description": "Add the v2 cache and update the existing configuration syntax.",
      "steps": [
        {
          "id": "create-v2-cache",
          "op": "mkdir",
          "path": "cache/v2"
        },
        {
          "id": "copy-default-theme",
          "op": "copy",
          "from": "assets/default-theme.json",
          "to": "cache/v2/theme.json",
          "optional": true
        },
        {
          "id": "update-config-key",
          "op": "replace",
          "path": "config/app.toml",
          "find": "cache_version = 1",
          "replace": "cache_version = 2",
          "optional": true
        }
      ]
    }
  ]
}

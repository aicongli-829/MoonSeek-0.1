{
  "classify": "custom",
  "conflict": "number",
  "sort": "name",
  "recursive": true,
  "hidden": false,
  "extensions": ["pdf", "doc", "docx", "ppt", "pptx", "xls", "xlsx", "txt", "md"],
  "exclude": ["已归档"],
  "rules": [
    { "kind": "remove", "value": "副本", "replacement": "" },
    { "kind": "spaces", "value": "", "replacement": "" },
    { "kind": "extension_lower", "value": "", "replacement": "" }
  ],
  "categories": [
    { "kind": "keyword", "value": "作业", "folder": "作业" },
    { "kind": "keyword", "value": "考试", "folder": "考试资料" },
    { "kind": "extension", "value": "ppt,pptx", "folder": "课件" },
    { "kind": "extension", "value": "pdf,doc,docx,txt,md", "folder": "讲义" },
    { "kind": "extension", "value": "xls,xlsx", "folder": "表格" }
  ]
}

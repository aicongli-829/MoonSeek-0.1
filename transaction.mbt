///| A transaction operation is produced by MoonBit after the preview and the
/// current inventory have been cross-checked. Fingerprints are attached by the
/// operating-system adapter because MoonBit never reads local files directly.
pub(all) struct TransactionOperation {
  source : String
  target : String
  stage : String
  phase : String
} derive(Eq, Debug, ToJson)

///| Decode the subset of a persisted operation needed for deterministic
/// validation and recovery decisions.
fn decode_transaction_operations(value : Json) -> Array[TransactionOperation] {
  array_field(value, "operations").map(operation => {
    source: text_field(operation, "source", ""),
    target: text_field(operation, "target", ""),
    stage: text_field(operation, "stage", ""),
    phase: text_field(operation, "phase", ""),
  })
}

///| UUIDs generated by the Node adapter are deliberately restricted to the
/// canonical lowercase representation used for history filenames.
pub fn transaction_id_valid(id : String) -> Bool {
  if id.length() != 36 {
    return false
  }
  for index = 0; index < id.length(); index = index + 1 {
    let character = id[index]
    if [8, 13, 18, 23].contains(index) {
      if character != 45 {
        return false
      }
    } else if !((character >= 48 && character <= 57) ||
      (character >= 97 && character <= 102)) {
      return false
    }
  }
  true
}

///| Journal statuses that represent unfinished work block a new transaction.
pub fn transaction_blocks_execution(status : String) -> Bool {
  ["running", "interrupted", "undoing", "undo-failed"].contains(status)
}

///| Every phase names one durable point in the two-stage move protocol.
pub fn transaction_phase_valid(phase : String) -> Bool {
  [
    "pending",
    "staged",
    "applying",
    "done",
    "undo-staging",
    "restaging",
    "restoring",
    "restored",
  ].contains(phase)
}

///| Legal phase changes. Rejecting impossible changes prevents the host from
/// accidentally skipping a journal checkpoint when transaction code evolves.
pub fn transaction_transition(phase : String, event : String) -> String? {
  match (phase, event) {
    ("pending", "stage") => Some("staged")
    ("staged", "apply-start") => Some("applying")
    ("applying", "apply-finish") => Some("done")
    ("done", "undo-stage-start") => Some("undo-staging")
    ("undo-staging", "undo-stage-finish") => Some("restaging")
    ("staged", "restore-start") => Some("restoring")
    ("restaging", "restore-start") => Some("restoring")
    ("restoring", "restore-start") => Some("restoring")
    ("restoring", "restore-finish") => Some("restored")
    _ => None
  }
}

///| Reconcile a process exit that happened after the filesystem move but before
/// the new phase reached disk. The host supplies `moved` only after proving the
/// source and destination are the same hard-linked file.
pub fn transaction_reconciled_phase(phase : String, moved : Bool) -> String? {
  match phase {
    "pending" => Some(if moved { "staged" } else { "pending" })
    "applying" => Some(if moved { "done" } else { "staged" })
    "undo-staging" => Some(if moved { "restaging" } else { "done" })
    "restoring" => Some(if moved { "restored" } else { "restoring" })
    phase if transaction_phase_valid(phase) => Some(phase)
    _ => None
  }
}

///| Location whose content must match the recorded fingerprint before undo.
pub fn transaction_current_path(operation : TransactionOperation) -> String? {
  match operation.phase {
    "pending" | "restored" => None
    "done" | "undo-staging" => Some(operation.target)
    "staged" | "applying" | "restaging" | "restoring" => Some(operation.stage)
    _ => None
  }
}

///| Build unique executable operations from a preview. This function does not
/// trust the browser or CLI: only ready rows and exact scanned paths are used.
pub fn prepare_transaction(
  id : String,
  rows : Array[PlanRow],
  scanned_paths : Array[String],
) -> (Array[TransactionOperation], Array[String]) {
  let errors = []
  let operations = []
  if !transaction_id_valid(id) {
    errors.push("批次编号不合法")
    return (operations, errors)
  }
  let known : Map[String, Bool] = Map([])
  for item in scanned_paths {
    known[item] = true
  }
  let sources : Map[String, Bool] = Map([])
  let targets : Map[String, Bool] = Map([])
  let mut ready_count = 0
  for row in rows {
    if row.status != "ready" {
      continue
    }
    ready_count = ready_count + 1
    if !known.contains(row.source) {
      errors.push("文件不在当前扫描中：" + row.source)
      continue
    }
    if row.source == row.target {
      continue
    }
    if path_error(row.source) is Some(error) {
      errors.push("源路径不合法：" + row.source + "（" + error + "）")
      continue
    }
    if path_error(row.target) is Some(error) {
      errors.push("目标路径不合法：" + row.target + "（" + error + "）")
      continue
    }
    let source_key = row.source.to_lower()
    let target_key = row.target.to_lower()
    if sources.contains(source_key) || targets.contains(target_key) {
      errors.push("计划包含重复源或目标")
      continue
    }
    sources[source_key] = true
    targets[target_key] = true
    operations.push({
      source: row.source,
      target: row.target,
      stage: ".filenest/stage/" + id + "/" + operations.length().to_string(),
      phase: "pending",
    })
  }
  if ready_count == 0 {
    errors.push("没有可执行的操作")
  } else if operations.length() == 0 && errors.length() == 0 {
    errors.push("计划没有需要移动的文件")
  }
  (operations, errors)
}

///| Validate the semantic part of a journal before the host resolves any path.
/// Exact stage names stop a modified history file from redirecting recovery.
pub fn validate_transaction_journal(
  id : String,
  operations : Array[TransactionOperation],
) -> Array[String] {
  let errors = []
  if !transaction_id_valid(id) {
    errors.push("批次编号不合法")
    return errors
  }
  let sources : Map[String, Bool] = Map([])
  let targets : Map[String, Bool] = Map([])
  for index, operation in operations {
    if path_error(operation.source) is Some(_) {
      errors.push("操作记录的源路径不合法")
    }
    if path_error(operation.target) is Some(_) {
      errors.push("操作记录的目标路径不合法")
    }
    let expected = ".filenest/stage/" + id + "/" + index.to_string()
    if operation.stage != expected {
      errors.push("暂存路径不匹配")
    }
    if !transaction_phase_valid(operation.phase) {
      errors.push("操作记录包含未知阶段：" + operation.phase)
    }
    let source_key = operation.source.to_lower()
    let target_key = operation.target.to_lower()
    if sources.contains(source_key) || targets.contains(target_key) {
      errors.push("操作记录包含重复源或目标")
    }
    sources[source_key] = true
    targets[target_key] = true
  }
  errors
}

///| Compute validation locations and ordered undo passes after reconciliation.
pub fn transaction_undo_plan(
  operations : Array[TransactionOperation],
) -> (Array[Int], Array[Int], Array[Int], Array[String]) {
  let validate = []
  let restage = []
  let restore = []
  let targets = []
  for index, operation in operations {
    if transaction_current_path(operation) is Some(_) {
      validate.push(index)
    }
    if operation.phase == "done" {
      restage.push(index)
      targets.push(operation.target)
    }
  }
  for index, operation in operations {
    if ["done", "staged", "restaging", "restoring"].contains(operation.phase) {
      restore.push(index)
    }
  }
  (validate, restage, restore, targets)
}

///| JavaScript boundary for transaction construction.
pub fn transaction_prepare_json(input : String) -> String {
  let document = @json.parse(input) catch {
    _ => return ({ "error": "事务输入不是合法 JSON" } : Json).stringify()
  }
  let id = text_field(document, "id", "")
  for status in strings_field(document, "historyStatuses") {
    if transaction_blocks_execution(status) {
      return ({ "error": "有未完成批次，请先在操作历史中恢复" } : Json).stringify()
    }
  }
  let rows = decode_report_rows({ "rows": array_field(document, "plan") })
  let scanned = strings_field(document, "scanned")
  let (operations, errors) = prepare_transaction(id, rows, scanned)
  if errors.length() > 0 {
    return ({ "error": errors.join("；") } : Json).stringify()
  }
  ({ "operations": operations.to_json() } : Json).stringify()
}

///| JavaScript boundary for journal validation and undo scheduling.
pub fn transaction_undo_plan_json(input : String) -> String {
  let document = @json.parse(input) catch {
    _ => return ({ "error": "操作记录不是合法 JSON" } : Json).stringify()
  }
  let id = text_field(document, "id", "")
  let operations = decode_transaction_operations(document)
  let errors = validate_transaction_journal(id, operations)
  if errors.length() > 0 {
    return ({ "error": errors.join("；") } : Json).stringify()
  }
  let (validate, restage, restore, targets) = transaction_undo_plan(operations)
  let locations = validate.map(index => transaction_current_path(operations[index]).unwrap_or(""))
  ({
    "validate": validate.to_json(),
    "locations": locations.to_json(),
    "restage": restage.to_json(),
    "restore": restore.to_json(),
    "targets": targets.to_json(),
  } : Json).stringify()
}

///| JavaScript boundary for checked phase transitions and crash reconciliation.
pub fn transaction_phase_json(input : String) -> String {
  let document = @json.parse(input) catch {
    _ => return ({ "error": "阶段输入不是合法 JSON" } : Json).stringify()
  }
  let phase = text_field(document, "phase", "")
  let event = text_field(document, "event", "")
  let result = if event == "reconcile-moved" {
    transaction_reconciled_phase(phase, true)
  } else if event == "reconcile-stationary" {
    transaction_reconciled_phase(phase, false)
  } else {
    transaction_transition(phase, event)
  }
  match result {
    Some(next) => ({ "phase": next } : Json).stringify()
    None => ({ "error": "不允许的事务阶段转换：" + phase + " / " + event } : Json).stringify()
  }
}
